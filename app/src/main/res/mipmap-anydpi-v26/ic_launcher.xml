<?xml version="1.0" encoding="utf-8"?>
<!--
  1.4.5: points at the fork's own art (ic_launcher_fork_*), not upstream's
  ic_launcher_background / ic_launcher_foreground. The distinct applicationId
  lets this build and the upstream one be installed at the same time, so they
  also have to be tellable apart on the launcher.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_fork_background" />
    <foreground android:drawable="@drawable/ic_launcher_fork_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_fork_foreground" />
</adaptive-icon>
