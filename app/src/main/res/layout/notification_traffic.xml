<?xml version="1.0" encoding="utf-8"?>
<!-- EXPANDED notification content: live dot + state + session total on top, one
     cell per direction below (rate large, cumulative volume small). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notif_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="@color/aether_primary"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/notif_state"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/state_connected"
            android:textColor="@color/aether_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_session"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/aether_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/notif_down_cell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/notif_cell_bg"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/notif_down_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/traffic_download"
                android:textAllCaps="true"
                android:textColor="@color/aether_text_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/notif_down_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textColor="@color/aether_primary"
                android:textDirection="ltr"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_down_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/aether_text_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notif_up_cell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/notif_cell_bg"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/notif_up_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/traffic_upload"
                android:textAllCaps="true"
                android:textColor="@color/aether_text_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/notif_up_rate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textColor="@color/aether_text"
                android:textDirection="ltr"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_up_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/aether_text_muted"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
