<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed connected card: one row, no background of its own.
     The system's decorated area supplies padding and surface; on Android 12+
     that area is 48dp tall, so the line height comes from dimens (values-v31
     is tighter) and the readouts auto-size instead of clipping.

     The download and upload readouts each sit in the same translucent gray
     well the expanded card uses (notif_cell_bg), so the live speed reads at a
     glance on light and dark shades and the two states look like one design.
     Cell padding is a dimen with a tighter Android 12+ value, so the cells
     never push the row past the 48dp budget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Download cell -->
    <LinearLayout
        android:id="@+id/notif_compact_down_cell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/notif_cell_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/notif_compact_cell_padding_h"
        android:paddingTop="@dimen/notif_compact_cell_padding_v"
        android:paddingEnd="@dimen/notif_compact_cell_padding_h"
        android:paddingBottom="@dimen/notif_compact_cell_padding_v">

        <TextView
            android:id="@+id/notif_compact_down_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:text="↓"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textColor="@color/notif_accent"
            android:textSize="@dimen/notif_compact_text_max"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_compact_down"
            android:layout_width="0dp"
            android:layout_height="@dimen/notif_compact_line_height"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="@dimen/notif_compact_text_max"
            android:autoSizeMinTextSize="@dimen/notif_compact_text_min"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="monospace"
            android:gravity="center_vertical|start"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textColor="@color/notif_accent"
            android:textDirection="ltr"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Upload cell -->
    <LinearLayout
        android:id="@+id/notif_compact_up_cell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/notif_cell_gap"
        android:layout_weight="1"
        android:background="@drawable/notif_cell_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/notif_compact_cell_padding_h"
        android:paddingTop="@dimen/notif_compact_cell_padding_v"
        android:paddingEnd="@dimen/notif_compact_cell_padding_h"
        android:paddingBottom="@dimen/notif_compact_cell_padding_v">

        <TextView
            android:id="@+id/notif_compact_up_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:text="↑"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="@dimen/notif_compact_text_max"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_compact_up"
            android:layout_width="0dp"
            android:layout_height="@dimen/notif_compact_line_height"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="@dimen/notif_compact_text_max"
            android:autoSizeMinTextSize="@dimen/notif_compact_text_min"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="monospace"
            android:gravity="center_vertical|start"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textDirection="ltr"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Session total stays outside the wells: secondary info, no emphasis -->
    <TextView
        android:id="@+id/notif_compact_total"
        android:layout_width="0dp"
        android:layout_height="@dimen/notif_compact_line_height"
        android:layout_marginStart="8dp"
        android:layout_weight="0.7"
        android:autoSizeMaxTextSize="@dimen/notif_label_text"
        android:autoSizeMinTextSize="@dimen/notif_compact_text_min"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:gravity="center_vertical|end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
        android:textDirection="ltr" />
</LinearLayout>
