<?xml version="1.0" encoding="utf-8"?>
<!-- COLLAPSED notification content. One row, because that is all the height a
     decorated custom view gets (~48dp): both speeds first, session total last. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notif_card_bg"
    android:gravity="center_vertical"
    android:minHeight="42dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/notif_compact_down_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="↓"
        android:textColor="@color/aether_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notif_compact_down"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:textColor="@color/aether_primary"
        android:textDirection="ltr"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notif_compact_up_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="↑"
        android:textColor="@color/aether_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notif_compact_up"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:textColor="@color/aether_text"
        android:textDirection="ltr"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notif_compact_total"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="@color/aether_text_muted"
        android:textDirection="ltr"
        android:textSize="11sp" />
</LinearLayout>
