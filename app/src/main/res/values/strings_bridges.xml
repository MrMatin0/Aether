    <string name="bridges_use_all">Select all</string>
    <string name="bridges_use_none">Clear these</string>

    <string name="bridges_fetch_title">Fetch from the Tor Project</string>
    <string name="bridges_fetch_note">Requests use bridges.torproject.org through your live tunnel, or directly without one. If Tor is blocked, connect with Aether or Psiphon first.</string>

    <string name="bridges_country_label">Your country (optional)</string>
    <string name="bridges_country_hint">e.g. IR</string>
    <string name="bridges_country_help">Enter two letters, or leave blank to let the server infer it from the request address. With a tunnel, that address is the tunnel exit, not your country.</string>
