    <string name="bridges_custom_title">Paste your own</string>
    <string name="bridges_custom_note">Enter one bridge per line, exactly as received. You can also send an empty email to bridges@torproject.org from Gmail or Riseup, or message @GetBridgesBot on Telegram.</string>
