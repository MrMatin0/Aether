    <string name="bridges_request">Request a bridge</string>
    <string name="bridges_request_vanilla">The Tor Project does not issue plain bridges this way. Choose an obfuscated type.</string>
    <string name="bridges_personal_list">Bridges you have received</string>
    <string name="bridges_personal_empty">No bridges yet. Requests add two or three addresses and survive a settings reset.</string>

