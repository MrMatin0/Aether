<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy for the Tor bridges page.

  Its own file, same reasoning as strings_chain.xml: this is the wording most
  likely to be revised as transports come and go, and one file per language
  keeps a translation diff readable.

  A note on tone. Every string here that describes a bridge source also says
  HOW IT FAILS, because that is the only thing that lets a user pick the next
  one when the current one stops working - and on this page every option works
  right up until a censor notices it.

  Two lengths per source. The page shows the full description only for the
  option that is selected and the _tag line for the rest, so a tag has to be
  the shortest true version of the same warning, not a restatement of the name.
-->
<resources>

    <!-- ============================================================ page == -->
    <string name="section_bridges">Tor bridges</string>
    <string name="section_bridges_note">Use a Tor bridge when your network blocks Tor. Choose a built-in bridge, fetch one, or add your own.</string>

    <string name="bridges_no_tor_core">This build has no Tor core, so bridges cannot be configured. Build it with scripts/build-overlay-cores.sh tor.</string>
    <string name="bridges_chain_has_no_tor">Your chain does not use Tor. These bridges are saved but inactive until you choose a Tor mode.</string>

    <!-- ========================================================== status == -->
    <string name="bridges_status_off">Bridges are off</string>
    <string name="bridges_status_off_note">Tor connects directly to public relays. Turn bridges on only when Tor cannot connect.</string>
    <string name="bridges_status_empty">No bridge picked yet</string>
    <string name="bridges_status_empty_note">Select a bridge or fetch a set. Until then, Tor connects through public relays.</string>
    <!-- %1$d is how many bridges tor will be given. -->
    <string name="bridges_status_ready">%1$d bridges ready</string>
    <string name="bridges_status_ready_note">Tor tries these bridges in order when it starts.</string>
    <!-- %1$d is how many selected bridges this build cannot run. -->
    <string name="bridges_tag_unusable">%1$d unusable</string>
    <string name="bridges_tag_no_tor">Not used by this chain</string>

    <!-- ========================================================= sources == -->
    <string name="bridges_mode_label">Bridge source</string>

    <string name="bridge_mode_off">No bridges</string>
    <string name="bridge_mode_off_desc">Tor connects directly to public relays. Fastest unless your network blocks Tor.</string>
    <string name="bridge_mode_off_tag">Fastest until Tor is blocked</string>

    <string name="bridge_mode_builtin">Built-in bridges</string>
    <string name="bridge_mode_builtin_desc">The public list included with Tor Browser. Always available, but blocked first because everyone has it.</string>
    <string name="bridge_mode_builtin_tag">Public list, blocked first</string>

    <string name="bridge_mode_requested">Personal bridge</string>
    <string name="bridge_mode_requested_desc">Tor Project addresses issued only to this device. You still need a working path to request them.</string>
    <string name="bridge_mode_requested_tag">Yours alone, needs a way out first</string>

    <string name="bridge_mode_custom">Paste your own</string>
    <string name="bridge_mode_custom_desc">Bridge lines you already have from email, Telegram, or someone you trust. They are only as reliable as their source.</string>
    <string name="bridge_mode_custom_tag">Lines you already have</string>

    <!-- ========================================================== types == -->
    <string name="bridges_type_title">Bridge type</string>
    <string name="bridges_type_hint">Start with obfs4. Try Snowflake or WebTunnel when fixed bridge addresses are blocked.</string>
    <!-- %1$s is a comma-separated list of missing plugin names. -->
    <string name="bridges_plugins_missing">This build lacks these transports: %1$s. Build them with scripts/build-pt-transports.sh.</string>
    <!-- %1$s is the name of the missing pluggable-transport binary. -->
    <string name="bridges_type_unavailable">Unavailable: this build has no %1$s binary.</string>
    <!-- %1$s is the binary a bridge of this type needs and this build lacks. -->
    <string name="bridges_needs">Needs %1$s</string>
    <!-- %1$d is how many built-in bridges of that type are known. -->
    <string name="bridges_builtin_count">%1$d ready</string>

    <string name="bridge_tr_obfs4">obfs4</string>
    <string name="bridge_tr_obfs4_desc">Makes traffic look random. Common, low-cost, and widely supported.</string>

    <string name="bridge_tr_snowflake">Snowflake</string>
    <string name="bridge_tr_snowflake_desc">Uses short-lived volunteer proxies over WebRTC. Useful when fixed addresses are blocked; speed varies.</string>

    <string name="bridge_tr_webtunnel">WebTunnel</string>
    <string name="bridge_tr_webtunnel_desc">Looks like an ordinary HTTPS visit. Useful when the network blocks unrecognised traffic.</string>

    <string name="bridge_tr_meek">meek</string>
    <string name="bridge_tr_meek_desc">Hides the connection behind a large CDN. Slow and data-heavy, but harder to block.</string>

    <string name="bridge_tr_vanilla">Plain bridge</string>
    <string name="bridge_tr_vanilla_desc">An address without obfuscation. Needs no extra binary, so it works in every build.</string>

    <!-- ======================================================== built-in == -->
    <string name="bridges_builtin_title">Built-in bridges</string>
    <string name="bridges_builtin_note">These bridges are public and shared, so they may be listed and blocked. Request a personal bridge if they fail.</string>
    <string name="bridges_builtin_none">No built-in bridge of this type. Refresh the list or request a personal bridge.</string>
    <!-- %1$d is how many bridges of the chosen type this app knows about. -->
