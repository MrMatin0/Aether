    <string name="automation_subtitle">این‌که Aether چه زمانی خودش وصل شود و چه چیزی روی این دستگاه نگه دارد.</string>
    <string name="auto_launch_title">اتصال هنگام باز شدن برنامه</string>
    <string name="auto_launch_desc">به‌محض اجرای Aether، تونل با آخرین تنظیمات شما بالا می‌آید.</string>
    <string name="auto_boot_title">اتصال پس از روشن شدن دستگاه</string>
