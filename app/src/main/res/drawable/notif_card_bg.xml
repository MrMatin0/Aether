<?xml version="1.0" encoding="utf-8"?>
<!-- The notification card. Self-contained dark surface so the readout keeps its
     contrast in a light shade as well as a dark one. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/aether_surface" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="#262E20" />
</shape>
