<?xml version="1.0" encoding="utf-8"?>
<!--
  FORK LAUNCHER BACKGROUND. Upstream's ic_launcher_background.xml is left
  untouched on purpose: fork-only art in fork-only files means a later merge
  from upstream can never conflict over the icon.

  Violet instead of upstream's navy, and a diamond instead of its upward
  triangle. Colour is what the eye resolves first at launcher size, so the hue
  shift is doing most of the work here.

  The diamond spans 18..90, i.e. it stays inside the circle an adaptive-icon
  mask can crop to (radius 36 from centre), so no launcher shape lops a point
  off it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#1B0A2E"
        android:pathData="M0,0h108v108h-108z" />
    <path
        android:fillColor="#33125C"
        android:pathData="M54,18L90,54L54,90L18,54z" />
</vector>
