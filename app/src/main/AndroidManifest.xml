<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      1.3.0: "Connect after a restart" (Settings > Automation). Opt-in and off
      by default; the receiver does nothing at all unless the user turned it on
      AND VPN consent was already granted.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      1.2.2 SECURITY: REQUEST_INSTALL_PACKAGES was REMOVED together with the
      in-app updater. The app can no longer download or hand an APK to the
      system package installer, so there is no runtime code-delivery path at
      all. Updates come exclusively from the officially signed GitHub Release
      page. This also drops the most over-privileged permission in the
      previous manifest.
    -->

    <!-- Split tunneling needs to list the device's launchable apps so the user
         can pick which apps to include/exclude from the tunnel. We only query
         launcher-visible apps (not QUERY_ALL_PACKAGES), which keeps Play policy
         happy and avoids the sensitive all-packages permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
      1.4.5: android:label is @string/app_label, NOT @string/app_name.
      app_label is generated from app/build.gradle.kts next to this fork's
      applicationId. The distinct applicationId is what lets this build and the
      upstream one be installed at the same time; the distinct label is what
      makes them tellable apart once they are, instead of two identical icons.
      app_name stays untouched so in-app copy still reads "Aether".
    -->
    <application
        android:name=".AetherApp"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_label"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AetherMobile">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.AetherMobile"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".vpn.AetherVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the Aether censorship-circumvention VPN tunnel while active" />
        </service>

        <!-- Quick Settings tile: one-tap connect/disconnect from the shade. -->
        <service
            android:name=".vpn.AetherTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/app_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          Home-screen widget (feature merge): one-tap connect /
          disconnect plus live status on the launcher. Not exported; only the
          system AppWidgetService delivers updates to it, and our toggle
          broadcast is sent with an explicit component, so no other app can
          trigger it. updatePeriodMillis=0 — repaints are pushed from the VPN
          service's state-change hook, never on a timer.
        -->
        <receiver
            android:name=".widget.AetherWidgetProvider"
            android:exported="false"
            android:label="@string/app_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aether_widget_info" />
        </receiver>

        <!--
          1.3.0: reconnect after a reboot. NOT exported — only the system
          delivers BOOT_COMPLETED, so no other app can nudge the tunnel up.
        -->
        <receiver
            android:name=".vpn.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          Crash report screen (feature merge): shows the fatal
          exception saved by AetherApp's crash handler on the previous run.
          Not exported; only MainActivity can open it.
        -->
        <activity
            android:name=".CrashReportActivity"
            android:exported="false"
            android:theme="@style/Theme.AetherMobile" />

        <!--
          1.2.2: the FileProvider that exported downloaded APKs to the system
          installer was removed along with the in-app updater. The app now
          exports no content provider whatsoever.
        -->

    </application>
</manifest>
